<head>
    <link rel="stylesheet" href="~/css/product.css" />
</head>
<div class="product-header container">
    <h2 class="text-primary">SẢN PHẨM</h2>

    <div class="product-top-bar d-flex justify-content-between align-items-center">
        <ul class="product-tabs">
            <li class="active text-primary">Tất cả sản phẩm</li>
            <li class="text-primary">Áo</li>
            <li class="text-primary">Quần</li>
            <li class="text-primary">Mũ</li>
            <li class="text-primary">Giày</li>
        </ul>

        <div class="product-actions">
            <button class="btn btn-outline-secondary">
                <i class="zmdi zmdi-filter-list"></i> Bộ lọc
            </button>
            <button class="btn btn-outline-secondary">
                <i class="zmdi zmdi-search"></i> Tìm kiếm
            </button>
        </div>
    </div>      
</div>

<!-- PRODUCT GRID -->
<div class="container mt-4">
    <div class="row g-4">

        <!-- PRODUCT CARD -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="product-card">
                <img src="/img/test1.jpg" class="product-img">

                <div class="product-info">
                    <span class="product-name">Esprit Ruffle Shirt</span>

                    <div class="product-bottom d-flex justify-content-between align-items-center">
                        <span class="product-price">$16.64</span>
                        <i class="zmdi zmdi-favorite-outline wishlist-icon"></i>
                    </div>
                </div>
            </div>

        </div>

        <!-- COPY NHIỀU SẢN PHẨM THEO KHUNG TRÊN -->
    </div>
</div>
<!-- Hiển thị thông báo thành công -->
@if (TempData["SuccessMessage"] != null)
{
    <script>
        toastr.success("@TempData["SuccessMessage"]");
    </script>
}
<script>
    toastr.options = {
        "closeButton": true,
        "progressBar": true,
        "positionClass": "toast-top-right",
        "timeOut": "3000"
    };
</script>
