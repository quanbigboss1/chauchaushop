<head>
    <style>
        .contact-box {
            padding: 25px;
            background: #fff;
            border-radius: 12px;
            border: 1px solid #e5e5e5;
            width: 100%;
        }

        .contact-title {
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .contact-list {
            padding: 0;
            margin: 0;
            list-style: none;
        }

            .contact-list li {
                margin-bottom: 14px;
                display: flex;
                align-items: flex-start;
                font-size: 15px;
                line-height: 1.6;
            }

            .contact-list i {
                font-size: 20px;
                color: #555;
                margin-right: 10px;
                margin-top: 3px;
            }

        .map-container {
            width: 100%;
            height: 260px;
            margin-top: 10px;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid #ddd;
        }

            .map-container iframe {
                width: 660px;
                height: 100%;
                border: 0;
            }

    </style>
</head>
<div style="margin-left:50px">
    <div class="mt-4 container contact-box d-flex justify-content-between ms-5">

        <div>
            <h3 class="contact-title">Cửa hàng quần áo Châu Châu Fashion</h3>

            <ul class="contact-list">
                <li>
                    <i class="zmdi zmdi-headset"></i>
                    <strong>Hotline:</strong> 1900.80xx
                </li>

                <li>
                    <i class="zmdi zmdi-time"></i>
                    <strong>Thời gian mở cửa: </strong>  8:00 – 19h Thứ 2 – Thứ 7
                </li>

                <li>
                    <i class="zmdi zmdi-pin"></i>
                    <strong>Chi nhánh 1:</strong>
                    236B Lê Văn Sỹ, Phường Tân Sơn Hòa, TP. Hồ Chí Minh.
                </li>
            </ul>
            <ul class="contact-list mt-4">
                <li>
                    <i class="zmdi zmdi-pin"></i>
                    <strong>Chi nhánh 2:</strong>
                    MMHR+5Q7, Nhơn Đức, Nhà Bè, Thành phố Hồ Chí Minh.
                </li>
            </ul>
        </div>

        <div>
            <!-- GOOGLE MAP - VP PHÍA BẮC -->
            <div class="map-container">
                <iframe src="https://www.google.com/maps?q=236B+Lê+Văn+Sỹ,+Tân+Sơn+Hòa,+Hồ+Chí+Minh&output=embed"
                        allowfullscreen=""
                        loading="lazy">
                </iframe>

            </div>
            <!-- GOOGLE MAP - VP PHÍA NAM -->
            <div class="map-container">
                <iframe src="https://www.google.com/maps?q=MMHR%2B5Q7+Nhơn+Đức,+Nhà+Bè,+Hồ+Chí+Minh&output=embed"
                        allowfullscreen=""
                        loading="lazy">
                </iframe>

            </div>
        </div>

    </div>

</div>